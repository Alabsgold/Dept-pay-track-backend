SECRET_KEY=django-insecure-test-key-for-development-only-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Throttle identity behind a reverse proxy. Local dev: 0 (default).
# On Render/production set 1 so rate limits apply per real client IP.
NUM_PROXIES=0
# Explicit frontend origins. Default to local frontend development only.
# Vite dev server runs on 5173 (dept-payments/vite.config.js); port 3000 is
# kept for other tooling. On Render set this to the deployed frontend origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_dummy_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_dummy_paystack_public_key

# BMONI Embedded (optional) — each department's own NGN virtual account.
# Leave BMONI_API_KEY empty and the feature is off: those endpoints answer 503
# instead of pretending an account exists. The sandbox is `embedded-dev`.
# Teammates can start against BMONI's PUBLIC shared sandbox key, which is
# published in their docs and shared with every team:
#     BMONI_API_KEY=pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4
# It can create users and issue NGN accounts in the sandbox, but its webhook
# subscription belongs to another partner, so our own deliveries cannot use it.
# Our own partner key replaces it; the shared key must never reach production.
# See docs/BMONI_SANDBOX_RUNBOOK.md for the verified walkthrough.
BMONI_API_KEY=
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# From GET /v1/webhooks/config once we own a subscription. Never commit a real value.
BMONI_WEBHOOK_SECRET=
